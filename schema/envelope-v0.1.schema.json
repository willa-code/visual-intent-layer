{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://visual-intent-layer.dev/schema/visual-intent-envelope-0.1.json",
  "title": "VisualIntentEnvelope",
  "description": "Experimental open schema for visually grounded human intent. Version 0.1.",
  "x-version": "0.1.0",
  "type": "object",
  "required": ["schemaVersion", "envelopeId", "artifact", "targets", "direction", "delivery", "createdAt"],
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {
      "description": "Envelope schema version. Major.minor; minor additions are backward compatible.",
      "const": "0.1"
    },
    "envelopeId": {
      "description": "Stable identifier so retries and redelivery are idempotent.",
      "type": "string",
      "minLength": 1
    },
    "artifact": {
      "type": "object",
      "required": ["id", "kind", "revision"],
      "additionalProperties": false,
      "properties": {
        "id": {
          "description": "Stable artifact identity independent of filesystem spelling or host conversation.",
          "type": "string",
          "minLength": 1
        },
        "kind": {
          "description": "Artifact adapter kind. New kinds extend the contract without breaking the core.",
          "type": "string",
          "enum": ["saved-html", "react-vite-app"]
        },
        "revision": {
          "description": "Immutable content-addressed revision: blake3 over canonical artifact bytes plus local asset manifest.",
          "type": "string",
          "pattern": "^blake3:[0-9a-f]{64}$"
        },
        "displayName": { "type": "string" },
        "sourceUri": { "type": "string" }
      }
    },
    "targets": {
      "description": "One or more visible target descriptions. Multiple targets form one target set.",
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/target" }
    },
    "relationships": {
      "description": "Relational Intent among targets, stored implementation-neutral.",
      "type": "array",
      "items": { "$ref": "#/$defs/relationship" },
      "default": []
    },
    "direction": {
      "description": "Human-written direction attached to the target set.",
      "type": "string",
      "minLength": 1
    },
    "constraints": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "default": []
    },
    "references": {
      "description": "Supporting references demonstrating desired appearance or behavior.",
      "type": "array",
      "items": { "$ref": "#/$defs/reference" },
      "default": []
    },
    "delivery": {
      "type": "object",
      "required": ["intent", "idempotencyKey"],
      "additionalProperties": false,
      "properties": {
        "intent": {
          "type": "string",
          "enum": ["draft", "steering", "next-pass", "review-interruption"]
        },
        "idempotencyKey": {
          "description": "Stable key so repeated delivery cannot create silent duplicates.",
          "type": "string",
          "minLength": 1
        },
        "requestedAt": { "type": "string", "format": "date-time" }
      }
    },
    "confidence": {
      "type": "object",
      "required": ["level"],
      "additionalProperties": false,
      "properties": {
        "level": {
          "type": "string",
          "enum": ["exact", "recovered", "ambiguous", "unavailable", "stale"]
        },
        "notes": { "type": "string" },
        "abstentions": {
          "type": "array",
          "items": { "type": "string" },
          "default": []
        }
      }
    },
    "supersedes": {
      "description": "Envelope id this envelope replaces, when the Builder-Reviewer supersedes outdated direction.",
      "type": "string"
    },
    "preview": {
      "$ref": "#/$defs/intentPreview"
    },
    "extensions": {
      "description": "Optional canvas-, host-, browser-, and framework-specific records. Never required portable semantics.",
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "canvas": { "type": "object", "additionalProperties": true },
        "host": { "type": "object", "additionalProperties": true },
        "browser": { "type": "object", "additionalProperties": true },
        "framework": { "type": "object", "additionalProperties": true }
      }
    },
    "createdAt": { "type": "string", "format": "date-time" },
    "updatedAt": { "type": "string", "format": "date-time" }
  },
  "$defs": {
    "target": {
      "type": "object",
      "required": ["targetId", "kind", "renderedGrounding", "provenanceConfidence"],
      "additionalProperties": false,
      "properties": {
        "targetId": { "type": "string", "minLength": 1 },
        "kind": { "type": "string", "enum": ["element", "text-range", "region"] },
        "renderedGrounding": { "$ref": "#/$defs/renderedGrounding" },
        "sourceProvenance": { "$ref": "#/$defs/sourceProvenance" },
        "provenanceConfidence": {
          "type": "string",
          "enum": ["exact", "recovered", "ambiguous", "unavailable", "stale"]
        },
        "label": { "type": "string" }
      },
      "allOf": [
        {
          "if": {
            "properties": { "provenanceConfidence": { "const": "exact" } },
            "required": ["provenanceConfidence"]
          },
          "then": {
            "required": ["sourceProvenance"],
            "properties": { "sourceProvenance": { "$ref": "#/$defs/sourceProvenance" } }
          }
        }
      ]
    },
    "renderedGrounding": {
      "description": "Evidence identifying a target within the visible artifact. Not a source claim.",
      "type": "object",
      "required": ["boundingBox"],
      "additionalProperties": false,
      "properties": {
        "selectors": {
          "description": "CSS selectors as evidence, not portable identity.",
          "type": "array",
          "items": { "type": "string" },
          "default": []
        },
        "boundingBox": {
          "type": "object",
          "required": ["x", "y", "width", "height"],
          "additionalProperties": false,
          "properties": {
            "x": { "type": "number" },
            "y": { "type": "number" },
            "width": { "type": "number", "minimum": 0 },
            "height": { "type": "number", "minimum": 0 },
            "viewportWidth": { "type": "number" },
            "viewportHeight": { "type": "number" },
            "devicePixelRatio": { "type": "number" }
          }
        },
        "textEvidence": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "exactText": { "type": "string" },
            "prefix": { "type": "string" },
            "suffix": { "type": "string" },
            "startOffset": { "type": "integer", "minimum": 0 },
            "endOffset": { "type": "integer", "minimum": 0 }
          }
        },
        "semanticRole": { "type": "string" },
        "accessibleName": { "type": "string" },
        "structuralContext": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "ancestorChain": { "type": "array", "items": { "type": "string" } },
            "siblingIndex": { "type": "integer", "minimum": 0 },
            "siblingCount": { "type": "integer", "minimum": 0 }
          }
        },
        "geometry": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "centerX": { "type": "number" },
            "centerY": { "type": "number" }
          }
        },
        "screenshotRef": { "type": "string" },
        "stableRuntimeId": { "type": "string" }
      }
    },
    "sourceProvenance": {
      "description": "Exact editable source location, supplied only by an instrumented adapter.",
      "type": "object",
      "required": ["file", "line", "column", "adapter"],
      "additionalProperties": false,
      "properties": {
        "file": { "type": "string", "minLength": 1 },
        "line": { "type": "integer", "minimum": 1 },
        "column": { "type": "integer", "minimum": 0 },
        "component": { "type": "string" },
        "adapter": { "type": "string", "minLength": 1 },
        "sourceSpan": { "type": "string" }
      }
    },
    "relationship": {
      "type": "object",
      "required": ["relationshipId", "type", "operator", "targetIds"],
      "additionalProperties": false,
      "properties": {
        "relationshipId": { "type": "string", "minLength": 1 },
        "type": {
          "type": "string",
          "enum": ["ordering", "alignment", "spacing", "containment", "equivalence", "comparative-size"]
        },
        "operator": {
          "description": "Implementation-neutral operator; valid values depend on type.",
          "type": "string",
          "enum": [
            "before", "after", "inside",
            "align-left", "align-center", "align-right", "align-top", "align-middle",
            "equal-gap", "preserved-rhythm",
            "member-of",
            "shared-property", "shared-behavior",
            "same-width", "same-height"
          ]
        },
        "targetIds": {
          "type": "array",
          "items": { "type": "string" },
          "minItems": 1
        },
        "property": {
          "description": "For equivalence: the visible property or behavior that should match.",
          "type": "string"
        }
      }
    },
    "reference": {
      "type": "object",
      "required": ["referenceId", "kind"],
      "additionalProperties": false,
      "properties": {
        "referenceId": { "type": "string", "minLength": 1 },
        "kind": { "type": "string", "enum": ["image", "url", "text", "envelope"] },
        "uri": { "type": "string" },
        "note": { "type": "string" }
      }
    },
    "intentPreview": {
      "description": "Reversible visual proposal. Records the demonstrated arrangement plus interaction evidence.",
      "type": "object",
      "required": ["previewId", "kind", "reversible"],
      "additionalProperties": false,
      "properties": {
        "previewId": { "type": "string", "minLength": 1 },
        "kind": { "type": "string", "enum": ["drag-to-reorder", "align", "match-size"] },
        "reversible": { "const": true },
        "relationshipIds": {
          "type": "array",
          "items": { "type": "string" },
          "default": []
        },
        "interactionEvidence": {
          "type": "object",
          "additionalProperties": true,
          "properties": {
            "startedAt": { "type": "string", "format": "date-time" },
            "confirmedAt": { "type": "string", "format": "date-time" },
            "discardedAt": { "type": "string", "format": "date-time" }
          }
        }
      }
    }
  }
}
